{
  "name": "zmod",
  "version": "2.2.4",
  "description": "Next-generation modular modding framework and loader for ZCode desktop client",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "zmod": "packages/zmod-cli/bin/zmod.js"
  },
  "scripts": {
    "test": "node --test packages/*/test/*.test.js",
    "zmod": "node packages/zmod-cli/bin/zmod.js",
    "doctor": "node packages/zmod-cli/bin/zmod.js doctor",
    "install-mod": "node packages/zmod-cli/bin/zmod.js install",
    "restore": "node packages/zmod-cli/bin/zmod.js restore"
  },
  "dependencies": {
    "@electron/asar": "^3.4.1"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "zcode",
    "mod",
    "loader",
    "electron",
    "framework"
  ],
  "author": "ZMod Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OkmiHonor/ZMod-for-ZCode.git"
  }
}
